PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rsr_lms?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Email (used for registration confirmation and optional admin notification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="RSR LMS" <your_email@gmail.com>
REGISTRATION_ADMIN_EMAIL=admin_email@gmail.com

# Optional: course title for the demo student. If omitted, the first course is used.
SEED_STUDENT_COURSE_TITLE=
